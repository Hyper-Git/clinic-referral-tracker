# Copy to .env and fill in. Never commit the real .env.

# Required. PostgreSQL connection string (SQLAlchemy format, psycopg driver):
#   postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://referrals:change-me@localhost:5432/referrals

# Network interface and port the app listens on (0.0.0.0 = all interfaces, needed inside a container).
APP_HOST=0.0.0.0
APP_PORT=8000

# Days waiting before a referral is flagged as overdue on the board.
URGENT_THRESHOLD_DAYS=14
ROUTINE_THRESHOLD_DAYS=42

# Seconds to wait when connecting to the database before giving up (keeps /health fast).
DB_CONNECT_TIMEOUT=3

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
